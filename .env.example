NODE_ENV=production
PORT=3230
POSTGRES_PASSWORD=
DATABASE_URL=postgres://aginti_wechat:change-me@postgres:5432/aginti_wechat

# Enable only after the company-owned WeChat Work test account has passed the POC.
WECHAT_ENABLED=false
WECHAT_CORP_ID=replace-with-corp-id
WECHAT_CORP_SECRET=replace-with-customer-service-api-secret
WECHAT_CALLBACK_TOKEN=replace-with-random-callback-token
WECHAT_ENCODING_AES_KEY=replace-with-43-character-encoding-aes-key
WECHAT_CALLBACK_PATH=/wecom/callback
WECHAT_OPEN_KF_IDS=replace-with-open-kfid
WECHAT_ACK_DELAY_MS=8000
WECHAT_MAX_MEDIA_BYTES=20971520

# Optional official Smart Bot WebSocket adapter for @OverTree group conversations.
# Keep disabled until a real customer-group POC confirms external WeChat members can use it.
WECHAT_GROUP_BOT_ENABLED=false
WECHAT_BOT_ID=replace-with-smart-bot-id
WECHAT_BOT_SECRET=replace-with-smart-bot-long-connection-secret

# Must match the optional, private bridge configured in OverTree Cloud.
CLOUD_BRIDGE_URL=http://cloud:3220
CLOUD_BRIDGE_SHARED_SECRET=
CLOUD_BRIDGE_TIMEOUT_MS=20000

# Generate a random 32-byte key and base64-encode it. Used to encrypt queued messages at rest.
WECHAT_DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
